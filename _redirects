# Cloudflare Pages redirects — clean URL langsung ke file asli
# GitHub Pages mengabaikan file ini (navigasi app pakai path file langsung).
# 301 dipakai agar path relatif aset (../js, ../akun, ../proyek) tetap benar.

# Home
/    /index.html    200

# Profil (akun)
/profil    /akun/Profile.html    301
/profil/    /akun/Profile.html    301
/profil/aktivitas    /akun/aktivitas.html    301
/profil/personal    /akun/personal.html    301
/profil/dompet    /akun/dompet.html    301
/profil/upgrade    /akun/upgrade.html    301
/profil/langganan    /akun/langganan.html    301
/profil/konfirmasi-langganan    /akun/konfirmasi-langganan.html    301
/profil/kolaborasi    /akun/kolaborasi.html    301
/profil/kontrol-data    /akun/kontrol-data.html    301
/profil/laporkan-bug    /akun/laporkan-bug.html    301
/profil/tentang    /akun/tentang.html    301
/notifikasi    /akun/notifikasi.html    301

# Halaman proyek — id proyek dipertahankan lewat ?id= (rute spesifik dulu, catch-all terakhir)
/workspace/*/pengaturan/umum    /proyek/umum.html?id=:splat    301
/workspace/*/pengaturan/build-deployment    /proyek/build-deployment.html?id=:splat    301
/workspace/*/pengaturan/domain-kustom    /proyek/domain-kustom.html?id=:splat    301
/workspace/*/pengaturan/keamanan-https    /proyek/keamanan-https.html?id=:splat    301
/workspace/*/pengaturan/visibilitas-akses    /proyek/visibilitas-akses.html?id=:splat    301
/workspace/*/pengaturan/integrasi-webhook    /proyek/integrasi-webhook.html?id=:splat    301
/workspace/*/pengaturan/zona-bahaya    /proyek/zona-bahaya.html?id=:splat    301
/workspace/*/pengaturan    /proyek/pengaturan.html?id=:splat    301
/workspace/*/chat    /proyek/chat.html?id=:splat    301
/workspace/*/environment    /proyek/environment.html?id=:splat    301
/workspace/*/keamanan    /proyek/keamanan.html?id=:splat    301
/workspace/*    /proyek/workspace.html?id=:splat    301

