# Cloudflare Pages redirects — clean URL nested routing

# Home
/    /index.html    200

# Projects list page (separated from index.html)
/proyek    /pages/proyek.html    200
/proyek/    /pages/proyek.html    200

# Profile (separated from index.html)
/profil    /pages/profil.html    200
/profil/    /pages/profil.html    200

# Profile sub-pages (account level)
/profil/aktivitas    /pages/aktivitas.html    200
/profil/personal    /pages/personal.html    200
/profil/dompet    /pages/dompet.html    200
/profil/upgrade    /pages/upgrade.html    200
/profil/langganan    /pages/langganan.html    200
/profil/konfirmasi-langganan    /pages/konfirmasi-langganan.html    200
/profil/kolaborasi    /pages/kolaborasi.html    200
/profil/kontrol-data    /pages/kontrol-data.html    200
/profil/laporkan-bug    /pages/laporkan-bug.html    200
/profil/tentang    /pages/tentang.html    200
/notifikasi    /pages/notifikasi.html    200

# Project-level pages — specific routes first (top to bottom, first match wins)
/workspace/*/pengaturan/umum    /pages/umum.html    200
/workspace/*/pengaturan/build-deployment    /pages/build-deployment.html    200
/workspace/*/pengaturan/domain-kustom    /pages/domain-kustom.html    200
/workspace/*/pengaturan/keamanan-https    /pages/keamanan-https.html    200
/workspace/*/pengaturan/visibilitas-akses    /pages/visibilitas-akses.html    200
/workspace/*/pengaturan/integrasi-webhook    /pages/integrasi-webhook.html    200
/workspace/*/pengaturan/zona-bahaya    /pages/zona-bahaya.html    200
/workspace/*/pengaturan    /pages/pengaturan.html    200
/workspace/*/chat    /pages/chat.html    200
/workspace/*/environment    /pages/environment.html    200
/workspace/*/keamanan    /pages/keamanan.html    200

# Catch-all for workspace (must be last — project_id only)
/workspace/*    /pages/workspace.html    200

